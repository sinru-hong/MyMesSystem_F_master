@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>登入 - MES系統</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .login-card {
            width: 400px;
            padding: 20px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            background: white;
            border-radius: 8px;
        }
        /* 【建議】增加點擊感 */
        .password-toggle {
            cursor: pointer;
        }

            .password-toggle:hover {
                background-color: #e9ecef;
            }
    </style>
</head>
<body>
    <div class="login-card">
        <h3 class="text-center mb-4">MES 系統登入</h3>
        <form action="/Home/VerifyLogin" method="post">
            <div class="mb-3">
                <label class="form-label">帳號</label>
                <input type="text" name="username" class="form-control"
                       value="@ViewBag.SavedUsername" required />
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label mb-0">密碼</label>
                    @if (ViewBag.Error != null)
                    {
                        <small class="text-danger fw-bold">@ViewBag.Error</small>
                    }
                </div>
                <div class="input-group">
                    <input type="password" name="password" id="passwordInput" class="form-control" required />
                    <span class="input-group-text password-toggle" onclick="togglePassword()">
                        <i class="bi bi-eye-slash" id="toggleIcon"></i>
                    </span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100">登入</button>
        </form>
    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                // 切換為「眼睛打開」圖示
                toggleIcon.classList.replace('bi-eye-slash', 'bi-eye');
            } else {
                passwordInput.type = 'password';
                // 切換為「眼睛斜線」圖示
                toggleIcon.classList.replace('bi-eye', 'bi-eye-slash');
            }
        }
    </script>
</body>
</html>