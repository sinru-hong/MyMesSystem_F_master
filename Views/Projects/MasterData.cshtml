
<div class="container-fluid py-3">
    <div class="d-flex flex-wrap gap-2 mb-3 bg-light p-2 border rounded">
        <button id="btnRefresh" class="btn btn-info text-white"><i class="bi bi-arrow-clockwise"></i> 刷新</button>
        <button id="btnQuery" class="btn btn-info text-white"><i class="bi bi-search"></i> 查詢</button>
        <button id="btnSave" class="btn btn-info text-white"><i class="bi bi-floppy"></i> 保存</button>
        <button id="btnAdd" class="btn btn-info text-white"><i class="bi bi-plus-lg"></i> 新增</button>
        <button id="btnEdit" class="btn btn-info text-white"><i class="bi bi-pencil-square"></i> 修改</button>
        <button id="btnDelete" class="btn btn-info text-white"><i class="bi bi-trash"></i> 刪除</button>
        <button id="btnImport" class="btn btn-info text-white"><i class="bi bi-file-earmark-excel"></i> 導入</button>
        <button id="btnExport" class="btn btn-info text-white"><i class="bi bi-file-earmark-arrow-up"></i> 導出</button>
    </div>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <div class="card mb-3">
        <div class="card-body">
            <div class="card-body">
                <form id="searchForm" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">建立人員</label>
                        <div class="input-group">
                            <input type="text" class="form-control" name="creator" id="inputCreator" readonly>
                            <button class="btn btn-outline-secondary" type="button"
                                    data-bs-toggle="modal" data-bs-target="#userSelectModal">
                                <i class="bi bi-display"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">建立日期</label>
                        <input type="text" class="form-control bg-white" name="createTime" id="inputCreateTime" placeholder="請選擇日期">
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="table-responsive border rounded bg-white" style="height: 60vh; overflow-y: auto;">
        <table class="table table-bordered table-hover table-sm mb-0">
            <thead class="table-light sticky-top">
                <tr class="text-nowrap">
                    <th>序號</th>
                    <th>操作</th>
                    <th>檔案路徑</th>
                    <th>備註</th>
                    <th>建立人員</th>
                    <th>建立日期</th>
                    <th>最後修改人員</th>
                    <th>最後修改日期</th>
                </tr>
            </thead>
            <tbody id="dataTableBody">
                <tr>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="userSelectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">人員主檔選單</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <span class="input-group-text">人員姓名/代碼</span>
                    <input type="text" id="modalSearchUser" class="form-control" placeholder="請輸入關鍵字...">
                    <button class="btn btn-primary" type="button" onclick="fetchUserData()">查詢</button>
                </div>
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>序號</th>
                                <th>人員代碼</th>
                                <th>人員名稱</th>
                            </tr>
                        </thead>
                        <tbody id="userModalTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="confirmUserSelect">確認</button>
            </div>
        </div>
    </div>
</div>

<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.3); z-index: 9999; justify-content: center; align-items: center; flex-direction: column;">
    <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
        <span class="visually-hidden">Loading...</span>
    </div>
    <div class="mt-2 text-white fw-bold">正在重新整理...</div>
</div>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@section Scripts {
    <script>
        const currentLoginUser = "@HttpContextAccessor.HttpContext?.Session.GetString("UserEmplNo")" || "未知用戶";
        console.log("當前操作者工號:", currentLoginUser);
    </script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/zh-tw.js"></script>
    <script src="~/js/MasterData.js"></script>
    <link rel="stylesheet" href="~/css/MasterData.css" />
}