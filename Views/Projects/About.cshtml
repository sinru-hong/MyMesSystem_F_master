<div class="container py-3 animate__animated animate__fadeIn">
    <div class="card-ios unified-card-style mb-5 p-4 p-md-5 overflow-hidden position-relative">
        <div class="position-absolute top-0 end-0 p-5 opacity-10">
            <i class="bi bi-code-square" style="font-size: 15rem;"></i>
        </div>

        <div class="row align-items-center position-relative">
            <div class="col-12 col-md-auto text-center mb-4 mb-md-0">
                <div class="avatar-container">
                    <img src="~/images/頭像.png"
                         class="rounded-circle shadow-lg main-avatar"
                         alt="欣汝">
                </div>
            </div>
            <div class="col-12 col-md ps-md-5">
                <div class="d-flex align-items-center justify-content-center justify-content-md-start mb-3">
                    <h1 class="display-5 fw-bold me-3 mb-0">欣汝</h1>
                    <span class="badge badge-ios-pill bg-dark text-white px-3">Full Stack Engineer</span>
                </div>
                <p class="text-secondary fs-5 mb-4 text-center text-md-start">
                    <i class="bi bi-geo-alt-fill me-2 text-primary"></i>🇹🇼 Taiwan, Software Developer
                </p>

                <div class="quote-box p-4 shadow-sm">
                    <p class="font-monospace text-dark mb-0 fw-bold fs-5">
                        <i class="bi bi-quote fs-3 text-muted me-2"></i>
                        以嚴謹的後端邏輯與解耦思維，建構高可靠性的智慧製造系統。
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card-ios unified-card-style h-100 p-4">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="bi bi-journal-text me-2"></i> 核心專案與經歷
                </h5>
                <div class="timeline-ios">
                    <div class="timeline-item pb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-bold text-dark fs-5">MES 系統開發與維護</span>
                        </div>
                        <p class="text-secondary mb-0">負責製造執行系統 (MES) 的開發與維護，使用 C# 開發ASP.NET Core MVC架構</p>
                        <p class="text-secondary mb-0">撰寫索引語句操作 SQL Server 處理大規模工業數據。</p>
                    </div>
                    <div class="timeline-item pb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-bold text-dark fs-5">可獨立API 資料串接</span>
                        </div>
                        <p class="text-secondary mb-0">開發解耦式 API 監控中心與非同步資料處理邏輯，大幅提升系統反應速率。</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card-ios unified-card-style p-4 mb-4">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="bi bi-cpu me-2 text-primary"></i> 技術棧
                </h5>
                <div class="d-flex flex-wrap gap-2">
                    <span class="skill-tag">C# / .NET</span>
                    <span class="skill-tag">Golang</span>
                    <span class="skill-tag">JavaScript</span>
                    <span class="skill-tag">Python</span>
                    <span class="skill-tag">MSSQL</span>
                    <span class="skill-tag">GitHub</span>
                    <span class="skill-tag">GitLab</span>
                    <span class="skill-tag">SourceTree</span>
                </div>
            </div>

            <div class="card-ios unified-card-style p-4">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="bi bi-book me-2 text-primary"></i> 持續進修
                </h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-3 d-flex align-items-center">
                        <i class="bi bi-translate me-3 fs-5 text-muted"></i>
                        <div>
                            <div class="fw-bold small">日文學習中</div>
                            <div class="text-muted smaller">目標 JLPT N3 / N5 已達成</div>
                        </div>
                    </li>
                    <li class="d-flex align-items-center">
                        <i class="bi bi-graph-up-arrow me-3 fs-5 text-muted"></i>
                        <div>
                            <div class="fw-bold small">Golang MVC後端架設</div>
                            <div class="text-muted smaller">轉換思維 架構後端專案</div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <link rel="stylesheet" href="~/css/about.css" />
}