@{
    ViewData["Title"] = "專業簡介 | 欣汝";
}

<div class="container mt-5">
    <div class="row align-items-center mb-5">
        <div class="col-12 col-md-auto text-center mb-4 mb-md-0">
            <img src="~/images/頭像.png"
                 class="rounded-circle border p-1 shadow"
                 alt="欣汝"
                 style="width: 180px; height: 180px; object-fit: cover;">
        </div>
        <div class="col-12 col-md ps-md-5">
            <div class="d-flex align-items-center mb-2">
                <h1 class="fw-bold me-3 mb-0">欣汝</h1>
                <span class="badge bg-primary rounded-pill">全端工程師</span>
            </div>
            <p class="text-secondary fs-5 mb-3"><i class="bi bi-geo-alt-fill me-1"></i>🇹🇼 Taiwan</p>

            <div class="border-start border-primary border-4 rounded p-3 bg-light shadow-sm">
                <p class="font-monospace text-dark mb-0 fw-bold">
                    「以嚴謹的後端邏輯與解耦思維，建構高可靠性的智慧製造系統。」
                </p>
            </div>
        </div>
    </div>

    <hr class="my-5" />

    <div class="row">
        <div class="col-lg-8">
            <section class="mb-5">
                <h4 class="fw-bold border-bottom pb-2 mb-4"><i class="bi bi-person-workspace me-2"></i>專業概述</h4>
                <p class="lh-lg">
                    具備近 **2 年 MES（製造執行系統）** 核心模組開發實務經驗。專精於使用 **C++ 與 JavaScript** 進行前後端分離架構設計，並在複雜的工廠邏輯管理（如 WMS 物料管理、製令流轉）領域有深厚累積。我擅長透過 **OOP 物件導向設計** 進行系統架構優化，曾成功透過邏輯解耦技術，大幅提升系統開發與維護效率。
                </p>
            </section>

            <section class="mb-5">
                <h4 class="fw-bold border-bottom pb-2 mb-4"><i class="bi bi-trophy-fill me-2"></i>關鍵成就與專案經驗</h4>
                <div class="card border-0 bg-light p-4 shadow-sm mb-4">
                    <h5 class="fw-bold text-primary">作業標準書暨程式版本維護系統</h5>
                    <p class="text-muted mb-3">獨立主導開發 | 益模管理技術</p>
                    <ul class="lh-lg">
                        <li><strong>技術挑戰：</strong> 克服跨路徑檔案自動化存取與 Excel 數據動態解析等複雜技術難點。</li>
                        <li><strong>核心貢獻：</strong> 實現產線文件集中化版本管理，達成 **文件版本「零錯誤」** 目標。</li>
                        <li><strong>影響力：</strong> 顯著提升生產過程的可追溯性，並強化系統在百萬級數據量下的穩定性。</li>
                    </ul>
                </div>
            </section>

            <section>
                <h4 class="fw-bold border-bottom pb-2 mb-4"><i class="bi bi-code-square me-2"></i>技術核心</h4>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 border rounded shadow-sm h-100">
                            <h6 class="fw-bold text-dark"><i class="bi bi-database-check me-2"></i>資料庫優化</h6>
                            <p class="small text-muted mb-0">具備獨立維護大型 MySQL 經驗，擅長索引優化（Indexing）與高效 SQL 撰寫，確保百萬級數據下的即時查詢效能。</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 border rounded shadow-sm h-100">
                            <h6 class="fw-bold text-dark"><i class="bi bi-box-seam me-2"></i>架構設計</h6>
                            <p class="small text-muted mb-0">貫徹前後端分離思維與物件導向設計，強調 ModelService 邏輯解耦，追求代碼的高可讀性與維護性。</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-4 mt-5 mt-lg-0">
            <div class="sticky-top" style="top: 20px;">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4">學經歷資訊</h5>
                        <ul class="list-unstyled">
                            <li class="mb-3 d-flex align-items-start">
                                <i class="bi bi-mortarboard-fill me-3 text-primary fs-5"></i>
                                <div>
                                    <strong>亞洲大學</strong><br />
                                    <span class="small text-muted">資訊工程學系 光電通訊組</span>
                                </div>
                            </li>
                            <li class="mb-3 d-flex align-items-start">
                                <i class="bi bi-briefcase-fill me-3 text-primary fs-5"></i>
                                <div>
                                    <strong>益模管理技術 (EMO)</strong><br />
                                    <span class="small text-muted">全端工程師 (2024/05 ~ 2025/12)</span>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4">技能</h5>
                        <div class="mb-3">
                            <span class="badge bg-dark me-1 mb-1">C#</span>
                            <span class="badge bg-dark me-1 mb-1">JavaScript</span>
                            <span class="badge bg-dark me-1 mb-1">MSSQL</span>
                            <span class="badge bg-dark me-1 mb-1">Git / GitHub</span>
                            <span class="badge bg-dark me-1 mb-1">SourceTree</span>
                            <span class="badge bg-dark me-1 mb-1">Postman</span>
                        </div>
                        <ul class="list-unstyled small">
                            <li class="mb-2"><i class="bi bi-translate me-2"></i>語言：JLPT N5 (目標 N3)、TOEIC 550</li>
                            <li class="mb-2"><i class="bi bi-journal-check me-2"></i>持續進修：Python 數據處理、日文</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}