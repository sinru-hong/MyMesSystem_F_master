<div class="container-fluid py-4">
    <h4 class="mb-4 text-primary"><i class="bi bi-terminal me-2"></i>API 介面模擬與監控</h4>

    <div class="input-group mb-3 shadow-sm">
        <select id="httpMethod" class="btn btn-outline-secondary fw-bold" style="width: 100px;">
            <option value="POST">POST</option>
            <option value="GET">GET</option>
        </select>
        <input type="text" id="apiUrl" class="form-control" value="https://localhost:44326/api/ProjectsApi/ProcessApiDemo">
        <button class="btn btn-primary px-4" id="btnSendApi">Send</button>
    </div>

    <div class="mb-3">
        <small class="text-muted me-2">快速切換：</small>
        <span class="badge bg-light text-dark border p-2 cursor-pointer" style="cursor:pointer"
              onclick="switchApi('POST', 'https://localhost:44326/api/ProjectsApi/ProcessApiDemo')">
            POST 範例 (驗證邏輯)
        </span>
        <span class="badge bg-light text-dark border p-2 cursor-pointer ms-2" style="cursor:pointer"
              onclick="switchApi('GET', 'https://localhost:44326/api/ProjectsApi/ProcessGetDemo?message=HelloWorld')">
            GET 範例 (參數傳遞)
        </span>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light fw-bold text-secondary d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-file-earmark-code me-1"></i> Request Body (JSON)</span>
                    <div class="btn-group">
                        <button type="button" class="btn btn-xs btn-outline-success" onclick="loadSample(true)">正確範本</button>
                        <button type="button" class="btn btn-xs btn-outline-danger" onclick="loadSample(false)">錯誤範本</button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <textarea id="requestJson" class="form-control border-0 font-monospace p-3"
                              style="height: 400px; background-color: #fcfcfc;" placeholder="請輸入 JSON 或點選範本..."></textarea>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light fw-bold text-secondary d-flex justify-content-between">
                    <span><i class="bi bi-reply-all me-1"></i> Response Body</span>
                    <span id="resStatus" class="badge bg-success" style="display:none;">Status: 200 OK</span>
                </div>
                <div class="card-body p-0">
                    <pre id="responseJson" class="m-0 p-3 bg-dark text-info font-monospace"
                         style="height: 400px; overflow-y: auto;">// 回傳結果將在此顯示...</pre>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ApiMonitor.js"></script>
}