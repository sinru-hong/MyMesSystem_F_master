@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    // 從 Session 判斷登入狀態
    var userEmplNo = HttpContextAccessor.HttpContext?.Session.GetString("UserEmplNo");
    bool IsLoggedIn = !string.IsNullOrEmpty(userEmplNo);
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MES系統</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex w-100 min-vh-100 p-3" style="background-color: var(--ios-bg);">
        <div class="main-card-container d-flex w-100 overflow-hidden shadow">

            @if (IsLoggedIn)
            {
                <aside class="inner-sidebar d-flex flex-column align-items-center py-4">
                    <div class="mb-5">
                        <img src="~/images/頭像.png" class="rounded-circle border border-2 border-white"
                             style="width: 45px; height: 45px; object-fit: cover;">
                    </div>

                    <div class="nav flex-column gap-3">
                        <a href="@Url.Action("Index", "Home")" class="nav-icon-link">
                            <i class="bi bi-grid-fill"></i>
                        </a>
                        <a href="@Url.Action("About", "Projects")" class="nav-icon-link">
                            <i class="bi bi-person-vcard-fill"></i>
                        </a>
                        <a href="@Url.Action("MasterData", "Projects")" class="nav-icon-link">
                            <i class="bi bi-database-fill-gear"></i>
                        </a>
                        <a href="@Url.Action("ApiMonitor", "Projects")" class="nav-icon-link">
                            <i class="bi bi-terminal-split"></i>
                        </a>
                    </div>

                    <div class="mt-auto">
                        <a href="@Url.Action("Logout", "Home")" class="text-secondary fs-4 logout-link">
                            <i class="bi bi-box-arrow-left"></i>
                        </a>
                    </div>
                </aside>
            }

            <main class="flex-grow-1 pt-3 pb-3 ps-5 pe-5 bg-white overflow-auto">
                @if (IsLoggedIn)
                {
                    <header class="d-flex justify-content-between align-items-center">
                        <h2 class="fw-bold m-0">@ViewData["Title"]</h2>
                        <span class="badge rounded-pill bg-light text-dark px-3 py-2 border">
                            <i class="bi bi-person-circle me-1"></i> @userEmplNo
                        </span>
                    </header>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>