@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    // 從 Session 判斷登入狀態
    var userEmplNo = HttpContextAccessor.HttpContext?.Session.GetString("UserEmplNo");
    bool IsLoggedIn = !string.IsNullOrEmpty(userEmplNo);

}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MES系統</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex w-100 min-vh-100 p-3" style="background-color: var(--ios-bg);">
        <div class="main-card-container d-flex w-100 overflow-hidden shadow">

            @if (IsLoggedIn)
            {
                <aside id="dynamicIsland" class="inner-sidebar d-flex flex-column align-items-center">
                    <div class="menu-toggle mb-auto" onclick="toggleMenu()">
                        <i class="bi bi-list"></i>
                    </div>

                    <div class="nav flex-column gap-3 align-items-center sub-menu-area">
                        <a href="@Url.Action("Index", "Home")" class="nav-icon-link">
                            <i class="bi bi-grid-fill"></i>
                            <span class="nav-text">控制台</span>
                        </a>
                        <a href="@Url.Action("About", "Projects")" class="nav-icon-link">
                            <i class="bi bi-person-vcard-fill"></i>
                            <span class="nav-text">基本資料</span>
                        </a>
                        <a href="@Url.Action("MasterData", "Projects")" class="nav-icon-link">
                            <i class="bi bi-database-fill-gear"></i>
                            <span class="nav-text">主數據管理</span>
                        </a>
                        <a href="@Url.Action("ApiMonitor", "Projects")" class="nav-icon-link">
                            <i class="bi bi-terminal-split"></i>
                            <span class="nav-text">API 監控</span>
                        </a>
                    </div>

                    <div class="mt-auto logout-container w-100 d-flex justify-content-center">
                        <a href="@Url.Action("Logout", "Home")" class="nav-icon-link logout-btn">
                            <i class="bi bi-box-arrow-left"></i>
                            <span class="nav-text">安全登出</span>
                        </a>
                    </div>
                </aside>

                <div id="menuOverlay" class="menu-overlay" onclick="toggleMenu()"></div>
            }
            
            <main class="flex-grow-1 pt-3 pb-3 ps-5 pe-5 bg-white overflow-auto">
                @if (IsLoggedIn)
                {
                    <header class="d-flex justify-content-between align-items-center">
                        <h2 class="fw-bold m-0">@ViewData["Title"]</h2>
                    </header>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function toggleMenu() {
            const sidebar = document.getElementById('dynamicIsland');
            const overlay = document.getElementById('menuOverlay');

            // 切換展開狀態
            sidebar.classList.toggle('expanded');
            // 切換模糊遮罩狀態
            overlay.classList.toggle('active');
        }
    </script>
</body>
</html>